<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PrimaryButton: زر أخضر بزوايا دائرية -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primary500Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Primary400Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- SecondaryButton: زر بإطار ذهبي وزوايا دائرية -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Gold400Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gold500Brush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource GoldSubtleBrush}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Gold300Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- CardBorder: حاوية بطاقة بزوايا دائرية وحشوة وظل خفيف -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000"
                                  Direction="270"
                                  ShadowDepth="2"
                                  BlurRadius="10"
                                  Opacity="0.18"
                                  RenderingBias="Performance" />
            </Setter.Value>
        </Setter>
    </Style>
    <!-- InputTextBox: حقل إدخال نصي   -->
    <Style x:Key="InputTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource Primary400Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <!-- في WPF حقل النص الداخلي يجب أن يحمل الاسم PART_ContentHost حصراً -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Primary500Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Primary400Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- InputPasswordBox: حقل كلمة المرور بنفس تصميم InputTextBox -->
    <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource Primary400Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Primary500Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Primary400Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- الأساس المشترك لشريط التنبيه (Banner) -->
    <Style x:Key="BannerBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- تحذير (Warning) -->
    <Style x:Key="BannerWarningBorder" TargetType="Border" BasedOn="{StaticResource BannerBorder}">
        <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Warning500Brush}" />
    </Style>

    <!-- خطر / خطأ (Danger) -->
    <Style x:Key="BannerDangerBorder" TargetType="Border" BasedOn="{StaticResource BannerBorder}">
        <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger500Brush}" />
    </Style>

    <!-- معلومة (Info) -->
    <Style x:Key="BannerInfoBorder" TargetType="Border" BasedOn="{StaticResource BannerBorder}">
        <Setter Property="Background" Value="{StaticResource InfoSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Info500Brush}" />
    </Style>

    <!-- نجاح (Success) -->
    <Style x:Key="BannerSuccessBorder" TargetType="Border" BasedOn="{StaticResource BannerBorder}">
        <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Success500Brush}" />
    </Style>
    <!-- حاوية العداد (-  8  +) -->
    <Style x:Key="CounterContainer" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- أزرار الزيادة والنقصان داخل العداد -->
    <Style x:Key="CounterButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Primary400Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Primary500Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- شريط تحميل مؤقت (Skeleton) -->
    <Style x:Key="SkeletonBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- الأساس المشترك للشارة (Badge) -->
    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="BadgeSuccessBorder" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
        <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
    </Style>

    <Style x:Key="BadgeWarningBorder" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
        <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}" />
    </Style>

    <Style x:Key="BadgeDangerBorder" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
        <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}" />
    </Style>

    <Style x:Key="BadgeInfoBorder" TargetType="Border" BasedOn="{StaticResource BadgeBorder}">
        <Setter Property="Background" Value="{StaticResource InfoSubtleBrush}" />
    </Style>
    <!-- شريط تقدم أساسي (أخضر) -->
    <Style x:Key="ProgressBarPrimary" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Primary400Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <!-- PART_Track: اسم قياسي في WPF يمثل المسار الكامل لشريط التقدم -->
                        <Border x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True" />
                        <!-- PART_Indicator: اسم قياسي في WPF يمثل مؤشر التقدم نفسه (الجزء الملون الذي يتمدد حسب قيمة Value) -->
                        <Border x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- شريط تقدم ذهبي -->
    <Style x:Key="ProgressBarGold" TargetType="ProgressBar" BasedOn="{StaticResource ProgressBarPrimary}">
        <Setter Property="Foreground" Value="{StaticResource Gold400Brush}" />
    </Style>
    <!-- مربع اختيار مخصص (Checkbox) -->
    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="PART_Box"
                                Width="20"
                                Height="20"
                                CornerRadius="6"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <!-- علامة الصح وتظهر فقط عند IsChecked = True -->
                            <!-- Stroke: لون الخط أو الحد المرسوم بالقلم (مثل حبر القلم لعلامة الصح، وليس تعبئة من الداخل) -->
                            <!-- StrokeThickness / LineCap / LineJoin: سماكة الخط وتنعيم أطرافه وزواياه -->
                            <Path x:Name="PART_CheckMark"
                                  Data="M3.5,10.5 L8.5,15.5 L16.5,5.5"
                                  Stroke="{StaticResource TextOnPrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>

                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Box" Property="BorderBrush" Value="{StaticResource Primary400Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Box" Property="Background" Value="{StaticResource Primary500Brush}" />
                            <Setter TargetName="PART_Box" Property="BorderBrush" Value="{StaticResource Primary500Brush}" />
                            <Setter TargetName="PART_CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ToggleSwitchStyle: مفتاح تشغيل/إيقاف (ToggleButton) يغيّر لونه وحركة الدائرة (Thumb) عند التفعيل (IsChecked) -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="PART_Track"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        CornerRadius="12"
                        Background="{StaticResource SurfaceInputBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="3"
                        SnapsToDevicePixels="True">
                        <!-- الدائرة المتحركة داخل المفتاح -->
                        <Ellipse x:Name="PART_Thumb"
                             Width="16"
                             Height="16"
                             Fill="{StaticResource TextPrimaryBrush}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Track" Property="BorderBrush" Value="{StaticResource Primary400Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Track" Property="Background" Value="{StaticResource Primary500Brush}" />
                            <Setter TargetName="PART_Track" Property="BorderBrush" Value="{StaticResource Primary500Brush}" />
                            <Setter TargetName="PART_Thumb" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- NavItemRadioStyle: ستايل عنصر القائمة الجانبية (RadioButton) يبرز الحالة النشطة بشريط ذهبي وخلفية داكنة -->
    <Style x:Key="NavItemRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PART_Container"
                        Background="{TemplateBinding Background}"
                        CornerRadius="12"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />

                            <Border x:Name="PART_ActiveBarRight"
                                Width="3"
                                Height="18"
                                CornerRadius="2"
                                Background="{StaticResource Gold400Brush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Container" Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Container" Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                            <Setter TargetName="PART_ActiveBarRight" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Gold400Brush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- TabPillRadioStyle: ستايل تبويب (Tab) بشكل كبسولة يبرز العنصر النشط (IsChecked) عن غير النشط -->
    <Style x:Key="TabPillRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PART_TabBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_TabBorder" Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Elevation/Card: ظل خفيف وناعم للبطاقات العادية -->
    <DropShadowEffect x:Key="ElevationCardEffect"
                  Color="#000000"
                  BlurRadius="16"
                  ShadowDepth="4"
                  Opacity="0.35" />

    <!-- Elevation/Dialog: ظل أعمق للنوافذ المنبثقة أو الحوارات -->
    <DropShadowEffect x:Key="ElevationDialogEffect"
                  Color="#000000"
                  BlurRadius="28"
                  ShadowDepth="8"
                  Opacity="0.55" />

    <!-- Glow/Gold: توهج ذهبي خفيف حول العنصر -->
    <DropShadowEffect x:Key="GlowGoldEffect"
                  Color="{StaticResource Gold400Color}"
                  BlurRadius="18"
                  ShadowDepth="0"
                  Opacity="0.35" />

</ResourceDictionary>