<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Fonts\Amiri-Regular.ttf" />
    <None Remove="Resources\Fonts\Tajawal-Black.ttf" />
    <None Remove="Resources\Fonts\Tajawal-Bold.ttf" />
    <None Remove="Resources\Fonts\Tajawal-ExtraBold.ttf" />
    <None Remove="Resources\Fonts\Tajawal-Medium.ttf" />
    <None Remove="Resources\Fonts\Tajawal-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Resources\Typography.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Typography.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\Amiri-Regular.ttf" />
    <Resource Include="Resources\Fonts\Tajawal-Black.ttf" />
    <Resource Include="Resources\Fonts\Tajawal-Bold.ttf" />
    <Resource Include="Resources\Fonts\Tajawal-ExtraBold.ttf" />
    <Resource Include="Resources\Fonts\Tajawal-Medium.ttf" />
    <Resource Include="Resources\Fonts\Tajawal-Regular.ttf" />
    <Resource Include="Resources\Typography.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
