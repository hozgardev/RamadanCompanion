<Application x:Class="RamadanCompanion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RamadanCompanion.Views"
             xmlns:vm="clr-namespace:RamadanCompanion.ViewModels"
             xmlns:local="clr-namespace:RamadanCompanion"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ربط ملف الألوان العام هنا -->
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/Icons/NavIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- ربط كل ViewModel بشاشته -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PrayerTimesViewModel}">
                <views:PrayerTimesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:QuranViewModel}">
                <views:QuranView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:WorshipViewModel}">
                <views:WorshipView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:GoalsViewModel}">
                <views:GoalsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>

    </Application.Resources>
    
</Application>
